# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# INSTAGRAM_ACCESS_TOKEN: Optional Instagram/Meta Graph API token to sync live @flyfello posts.
INSTAGRAM_ACCESS_TOKEN="MY_INSTAGRAM_ACCESS_TOKEN"
# INSTAGRAM_ACCOUNT_ID: Optional Instagram Business Account ID when using a Meta System User token.
INSTAGRAM_ACCOUNT_ID="MY_INSTAGRAM_ACCOUNT_ID"

# INQUIRY_WEBHOOK_URL: Optional server-side webhook URL (e.g. Formspree, Make, Zapier, Apps Script) to auto-forward holiday inquiries.
INQUIRY_WEBHOOK_URL="MY_INQUIRY_WEBHOOK_URL"

# VITE_INQUIRY_WEBHOOK_URL: Client-side fallback webhook URL (defaults to Formspree if unset) used automatically on static deployments without server.ts.
VITE_INQUIRY_WEBHOOK_URL="https://formspree.io/f/xaeojlae"

# Zoho Mail Outgoing SMTP Settings (for automatic Holiday Booking inquiry emails)
SMTP_HOST="smtp.zoho.in"
SMTP_PORT="465"
SMTP_USER="info@flyfello.in"
SMTP_PASS="MY_ZOHO_SMTP_APP_PASSWORD"
INQUIRY_TO_EMAIL="info@flyfello.in"

